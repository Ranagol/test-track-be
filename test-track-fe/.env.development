# This file is used to set environment variables for local development, for the frontend.
# When you run npm run dev (development mode), Vite automatically loads from .env.development
# VITE_ prefix requirement — Vite only exposes variables that start with VITE_ for security.
# import.meta.env — Vite's built-in object that exposes environment variables.
# This is replaced at build time (not runtime), so the value gets baked into your compiled code.
VITE_API_BASE_URL=http://localhost
