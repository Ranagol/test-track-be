includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - routes/
        - database/factories/
        - database/seeders/
        - tests/

    level: 6

    # Directories to ignore during analysis
    excludePaths:
        - vendor/
        - storage/
        - bootstrap/cache/

    # Ignore specific error patterns for Laravel
    ignoreErrors:
        # Laravel facade resolution
        - identifier: class.notFound
          path: app/
        # Laravel magic methods
        - identifier: method.notFound
          path: app/
          message: '/Call to an undefined method (Illuminate|Laravel)/'
        # Relationship methods on dynamically created models in seeders
        - identifier: method.notFound
          path: database/seeders/
        # Argument type mismatches from relationship create() in seeders
        - identifier: argument.type
          path: database/seeders/
          message: '/expects.*Model.*given/'
        # Eloquent generic types (BelongsTo, HasMany, Builder, etc.)
        - message: '/with generic class.*does not specify its types/'
        # Eloquent dynamic properties (accessed via __get)
        - identifier: property.notFound
          message: '/Access to an undefined property (Illuminate|App).*::\$\w+/'
        # Factory type hints (User::factory()->create() returns Collection or Model)
        - identifier: argument.type
          path: tests/
        - identifier: missingType.generics
          path: tests/
        # ValidationRule import used in PHPDoc type hints
        - identifier: useless.use
          message: '/^Imported class.*ValidationRule.*is not used/'
          path: app/Http/Requests/
        # Unresolved template types in collect() function
        - identifier: argument.templateType
          path: app/Http/Requests/StoreTestAttemptRequest.php
        # Array type hints without value types in TestControllerServiceInterface
        - identifier: missingType.iterableValue
          path: app/Interfaces/TestControllerServiceInterface.php
          message: '/has parameter .* with no value type specified in iterable type array/'
        # Array type hints without value types in TestControllerService
        - identifier: missingType.iterableValue
          path: app/Services/TestControllerService.php
          message: '/has parameter .* with no value type specified in iterable type array/'
        # FormRequest rules() method array return type
        - identifier: missingType.iterableValue
          message: '/return type has no value type specified in iterable type array/'
          path: app/Http/Requests/
        # Controller helper methods for nested validated payloads
        - identifier: missingType.iterableValue
          message: '/Method App\\Http\\Controllers\\Api\\TestController::createTest\(\) has parameter \$validatedData with no value type specified in iterable type array\./'
          path: app/Http/Controllers/Api/TestController.php
        - identifier: missingType.iterableValue
          message: '/Method App\\Http\\Controllers\\Api\\TestController::createQuestions\(\) has parameter \$questionsData with no value type specified in iterable type array\./'
          path: app/Http/Controllers/Api/TestController.php
        - identifier: missingType.iterableValue
          message: '/Method App\\Http\\Controllers\\Api\\TestController::createAnswerOptions\(\) has parameter \$answerOptionsData with no value type specified in iterable type array\./'
          path: app/Http/Controllers/Api/TestController.php
        - identifier: argument.type
          message: '/Parameter #1 \$question of method App\\Http\\Controllers\\Api\\TestController::createAnswerOptions\(\) expects App\\Models\\Question, Illuminate\\Database\\Eloquent\\Model given\./'
          path: app/Http/Controllers/Api/TestController.php
    # Do not fail if ignored errors are not found
    reportUnmatchedIgnoredErrors: false
