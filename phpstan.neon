includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - routes/
        - database/factories/
        - database/seeders/
        - tests/

    level: 8

    # Directories to ignore during analysis
    excludePaths:
        - vendor/
        - storage/
        - bootstrap/cache/

    # Ignore specific error patterns for Laravel
    ignoreErrors:
        # Laravel facade resolution
        - identifier: class.notFound
          path: app/
        # Laravel magic methods
        - identifier: method.notFound
          path: app/
          message: '/Call to an undefined method (Illuminate|Laravel)/'

    # Do not fail if ignored errors are not found
    reportUnmatchedIgnoredErrors: false
