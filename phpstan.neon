includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - routes/
        - database/factories/
        - database/seeders/
        - tests/

    level: 6

    # Directories to ignore during analysis
    excludePaths:
        - vendor/
        - storage/
        - bootstrap/cache/

    # Ignore specific error patterns for Laravel
    ignoreErrors:
        # Laravel facade resolution
        - identifier: class.notFound
          path: app/
        # Laravel magic methods
        - identifier: method.notFound
          path: app/
          message: '/Call to an undefined method (Illuminate|Laravel)/'
        # Eloquent generic types (BelongsTo, HasMany, Builder, etc.)
        - message: '/with generic class.*does not specify its types/'
        # Eloquent dynamic properties (accessed via __get)
        - identifier: property.notFound
          message: '/Access to an undefined property (Illuminate|App).*::\$\w+/'
        # Factory type hints (User::factory()->create() returns Collection or Model)
        - identifier: argument.type
          path: tests/
        - identifier: missingType.generics
          path: tests/
        # ValidationRule import used in PHPDoc type hints
        - identifier: useless.use
          message: '/^Imported class.*ValidationRule.*is not used/'
          path: app/Http/Requests/
        # FormRequest rules() method array return type
        - identifier: missingType.iterableValue
          message: '/return type has no value type specified in iterable type array/'
          path: app/Http/Requests/

    # Do not fail if ignored errors are not found
    reportUnmatchedIgnoredErrors: false
