#!/usr/bin/env bash

# Validate the configured PHP process user
if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sail" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sail' or 'root'."
    exit 1
fi

# Ensure Laravel writable directories are owned by the sail user.
# These directories live on the mounted volume and may have root ownership on a fresh clone.
chown -R sail:$WWWGROUP /var/www/html/storage /var/www/html/bootstrap/cache

# Start the application
if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu sail "$@"
    fi
else
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
