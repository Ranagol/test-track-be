#!/usr/bin/env bash

# 1. Check if the user is root or sail, otherwise exit with an error
if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sail" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sail' or 'root'."
    exit 1
fi

# 2. If the environment variable WWWUSER exists, change the UID of the sail user to match it.
if [ ! -z "$WWWUSER" ]; then
    usermod -u "$WWWUSER" sail
fi

# 3. This block prepares/creates a shared Composer directory and makes it writable.
if [ ! -d /.composer ]; then
    mkdir /.composer
fi
chmod -R ugo+rw /.composer

# Ensure storage directory is writable by sail user for view compilation
if [ -d /var/www/html/storage ]; then
    chmod -R 775 /var/www/html/storage
    chown -R "$WWWUSER:$WWWUSER" /var/www/html/storage
fi

# 5. Finally, start the application (supervisord or a custom command)
if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu "$WWWUSER" "$@"
    fi
else
    # Run supervisord as the specified user
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
