# This Dockerfile is used to build the frontend application and serve it using Nginx, on Oracle
# This is not used in the local development.
FROM node:22-alpine AS build
WORKDIR /app
COPY test-track-fe/package*.json ./
RUN npm ci
COPY test-track-fe/ .
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx/frontend.conf /etc/nginx/conf.d/default.conf
